# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_automator

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scraper settings
SCRAPE_INTERVAL_HOURS=4
MATCH_INTERVAL_MINUTES=30
AUTO_APPLY_THRESHOLD=90

# Location settings
PRIMARY_LOCATION=Hyderabad
ACCEPT_REMOTE_INDIAN=true

# Job search keywords (comma separated)
DEFAULT_KEYWORDS=product manager,builder PM,product lead

# Active portals (comma separated)
DEFAULT_PORTALS=linkedin,naukri,wellfound,cutshort,iimjobs,hirect,foundit,indeed
